NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://sitio:sitio@db:5432/sitio
APP_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-por-um-segredo-longo-com-32-caracteres
PUBLIC_APP_URL=http://localhost:3000
SEED_DEMO_DATA=true

STORAGE_MODE=local
LOCAL_STORAGE_PATH=/data/uploads

# Railway Bucket (produção; use as credenciais S3 injetadas pelo Railway).
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto

# Linguagem natural (áudio/documento/texto → ação). Opcional.
# Sem a chave, a captura por voz fica desativada (endpoints 503, UI oculta).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STT_MODEL=google/chirp-3
OPENROUTER_STT_FALLBACK_MODEL=openai/gpt-4o-mini-transcribe
OPENROUTER_INTENT_MODEL=google/gemini-3.1-flash-lite
